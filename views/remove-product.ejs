<section class="relative flex items-center justify-center h-[150px] m-3 rounded-lg shadow-md overflow-hidden">
    <img class="absolute inset-0 w-full h-full object-cover"
         src="/images/Po_bg.jpg" 
         alt="Poligonal Background">
    <div class="z-10 text-white text-4xl font-bold text-center">
        <h1>Remove Product</h1>
    </div>
</section>

<section class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-center text-purple-800 mb-8">Remove Product</h1>
    
    <div class="max-w-lg mx-auto bg-white shadow-md rounded-lg p-6">
        <p class="text-lg text-gray-700 mb-6">Are you sure you want to delete this product?</p>

        <!-- Product Details -->
        <div class="mb-4">
            <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="w-full h-48 object-cover rounded mb-4">
            <h2 class="text-xl font-bold mb-2"><%= product.title %></h2>
            <p class="text-gray-600 mb-2"><%= product.description %></p>
            <p class="text-purple-600 font-bold mb-2">$<%= product.price.toFixed(2) %></p>
        </div>
        
        <!-- Confirmation Form -->
        <form action="/inventory/remove/<%= product._id %>" method="POST" class="flex justify-between">
            <button type="submit" class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">
                Yes, Delete
            </button>
            <a href="/inventory/list" class="bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
                Cancel
            </a>
        </form>
    </div>
</section>
