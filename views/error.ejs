<section class ="relative flex items-center justify-center h-[150px] m-3 rounded-lg shadow-md overflow-hidden">
    <img class="absolute inset-0 w-full h-full object-cover"
    src="/images/Po_bg.jpg" 
    alt="Poligonal Background" 
     >
    <div class="z-10 text-white text-4xl font-bold text-center">
        <h1>From Ashes to Brilliance</h1>
    </div>
</section>

<section class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-center text-purple-800 mb-8">Oops! Something went wrong.</h1>
    
    <div class="bg-white shadow-md rounded-lg p-6 text-center">
        <!-- Display the error message dynamically -->
        <p class="text-lg text-gray-700 mb-4"><%= message || "An unexpected error occurred. Please try again later." %></p>
        <a href="/log-in" class="text-purple-600">Go to Log In</a>
    </div>
</section>
