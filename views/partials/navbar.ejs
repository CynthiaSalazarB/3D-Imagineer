<header class="studio-header">
    <div class="studio-shell studio-header-inner">
        <a href="/" class="studio-wordmark">3D Imagineer<span aria-hidden="true">.</span></a>
        <nav class="studio-nav" aria-label="Main navigation">
            <a href="/">Home</a>
            <a href="/inventory">Catalog</a>
            <% if (!locals.user) { %>
                <a href="/sign-up">Sign up</a>
                <a href="/log-in" class="studio-nav-action">Log in</a>
            <% } else { %>
                <% const customer = locals.user.role === 'customer'; %>
                <a href="<%= customer ? '/cart' : '/inventory/list' %>" class="studio-nav-action"><%= customer ? 'Cart' : 'Manage inventory' %></a>
                <a href="/log-out">Log out</a>
            <% } %>
        </nav>
    </div>
</header>
