<header class="flex flex-col md:flex-row items-center justify-between p-4 bg-base-200 border border-gray-300 rounded-lg shadow-md m-3">
    <div class = "flex items-center">
    <a href="/" class="flex items-center">
    <img class="h-20 w-auto object-contain rounded-lg"
         id="logo"
         src = "/images/logo1.png" 
         alt="Logo image"
         >
    </a>
    </div>
    
    <nav class="flex flex-wrap gap-6 mt-4 md:mt-0">
         <a href="/" class="text-lg font-bold text-purple-800 hover:text-yellow-400 transition duration-300">Home</a>
         <a href="/inventory" class="text-lg font-bold text-purple-800 hover:text-yellow-400 transition duration-300">Inventory</a>

         <% if (!locals.user) { %>
          <a href="/sign-up" class="text-lg font-bold text-purple-800 hover:text-yellow-400 transition duration-300">Sign Up</a>
         <a href="/log-in" class="text-lg font-bold text-purple-800 hover:text-yellow-400 transition duration-300">Login</a>
      <% } else { %>
          <a href="<%= locals.user.role === 'customer' ? '/cart' : '/inventory/list' %>" class="text-lg font-bold text-purple-800 hover:text-yellow-400 transition duration-300">Hello <%= locals.user.firstName %></a>
          <a href="/log-out" class="text-lg font-bold text-purple-800 hover:text-yellow-400 transition duration-300">Log out</a>
      <% } %>

         
    </nav>

 </header>