<article class="studio-product">
    <img class="studio-product-art" src="<%= product.imageUrl %>" alt="<%= product.title %>" loading="lazy">
    <div class="studio-product-details">
        <% if (product.category) { %>
            <p class="studio-product-category"><%= product.category === 'Sceneries' ? 'Scenes' : product.category %></p>
        <% } %>
        <div class="studio-product-meta">
            <h3><%= product.title %></h3>
            <p class="studio-price">
                <% if (product.salePrice) { %>
                    <s><span class="sr-only">Regular price </span>$<%= product.price.toFixed(2) %></s>
                    <span><span class="sr-only">Sale price </span>$<%= product.salePrice.toFixed(2) %></span>
                <% } else { %>
                    <span>$<%= product.price.toFixed(2) %></span>
                <% } %>
            </p>
        </div>
        <% if (locals.user && locals.user.role === 'customer') { %>
            <form action="/cart/add/<%= product._id %>" method="POST">
                <button type="submit" class="studio-button studio-button-small" aria-label="Add to cart: <%= product.title %>">Add to cart</button>
            </form>
        <% } %>
    </div>
</article>
