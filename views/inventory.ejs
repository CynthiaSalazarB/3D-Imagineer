<%
    const collections = new Map([
        ['Interior Design', { id: 'interiors', label: 'Interiors' }],
        ['Characters', { id: 'characters', label: 'Characters' }],
        ['Sceneries', { id: 'scenes', label: 'Scenes' }],
    ]);
    const groups = categorizedProducts.map(({ category, products }, index) => ({
        ...(collections.get(category) ?? { id: `collection-${index}`, label: category }),
        products,
    }));
%>
<section class="studio-shell studio-catalog" aria-labelledby="catalog-title">
    <div class="studio-catalog-head">
        <h1 id="catalog-title" class="studio-display">3D model catalog</h1>
        <% if (groups.length) { %>
            <nav class="studio-catalog-nav" aria-label="Collections">
                <% groups.forEach(({ id, label }) => { %>
                    <a href="#<%= id %>"><%= label %></a>
                <% }); %>
            </nav>
        <% } else { %>
            <p class="studio-intro">There are no models in the catalog right now.</p>
        <% } %>
    </div>

    <% groups.forEach(({ id, label, products }) => { %>
        <section class="studio-section studio-catalog-group" aria-labelledby="<%= id %>">
            <div class="studio-section-head">
                <h2 id="<%= id %>" class="studio-heading"><%= label %></h2>
                <span class="studio-count"><%= products.length %> <%= products.length === 1 ? 'model' : 'models' %></span>
            </div>
            <div class="studio-products">
                <% products.forEach(product => { %>
                    <%- include('./partials/product', { product }) %>
                <% }); %>
            </div>
        </section>
    <% }); %>
</section>
