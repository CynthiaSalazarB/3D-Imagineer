<section class="studio-hero studio-shell" aria-labelledby="studio-title">
    <div class="studio-hero-copy">
        <h1 id="studio-title" class="studio-display">Build your<br>next world.</h1>
        <p class="studio-intro">Explore 3D interiors, characters, and scenes for the world you’re making.</p>
        <a class="studio-button" href="/inventory">Browse the catalog <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="studio-hero-art">
        <img src="/images/blueroom.jpg" alt="Isometric room render with a blue sofa, desk, and large windows" fetchpriority="high">
        <figcaption><span>Modern Bedroom</span><span>Interior design</span></figcaption>
    </figure>
</section>

<section class="studio-section studio-shell" aria-labelledby="collections-title">
    <div class="studio-section-head">
        <h2 id="collections-title" class="studio-heading">Explore by collection</h2>
        <a class="studio-text-link" href="/inventory">All models <span aria-hidden="true">↗</span></a>
    </div>
    <div class="studio-collections">
        <a class="studio-collection" href="/inventory#interiors">
            <img src="/images/kitchen.png" alt="" loading="lazy">
            <h3>Interiors <span aria-hidden="true">↗</span></h3>
        </a>
        <a class="studio-collection" href="/inventory#characters">
            <img src="/images/tortoise.jpg" alt="" loading="lazy">
            <h3>Characters <span aria-hidden="true">↗</span></h3>
        </a>
        <a class="studio-collection" href="/inventory#scenes">
            <img src="/images/space.jpg" alt="" loading="lazy">
            <h3>Scenes <span aria-hidden="true">↗</span></h3>
        </a>
    </div>
</section>

<% if (featuredProducts.length) { %>
    <section class="studio-section studio-shell" aria-labelledby="featured-title">
        <div class="studio-section-head">
            <h2 id="featured-title" class="studio-heading">Featured models</h2>
        </div>
        <div class="studio-products">
            <% featuredProducts.forEach(product => { %>
                <%- include('./partials/product', { product }) %>
            <% }); %>
        </div>
    </section>
<% } %>
