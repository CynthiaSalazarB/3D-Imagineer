<section class ="relative flex items-center justify-center h-[150px] m-3 rounded-lg shadow-md overflow-hidden">
    <img class="absolute inset-0 w-full h-full object-cover"
    src="/images/Po_bg.jpg" 
    alt="Poligonal Background" 
     >
    <div class="z-10 text-white text-4xl font-bold text-center">
        <h1>From Ashes to Brilliance</h1>
    </div>
</section>

<section class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-center text-purple-800 mb-8">Your Shopping Cart</h1>
    
   <!-- Display the dynamic message -->
   <% if (message) { %>
    <div class=" text-purple-700 px-4 py-3 rounded relative mb-6 text-center">
        <strong class="font-bold"><%= message %></strong>
    </div>
<% } %>



    <% if (cart && cart.items && cart.items.length > 0) { %>
    <div class="grid grid-cols-1 gap-4">
        <% cart.items.forEach(item => { %>
            <div class="bg-white shadow-md rounded-lg p-4 flex items-center">
                <img src="<%= item.product.imageUrl %>" alt="<%= item.product.title %>" class="w-24 h-24 object-cover mr-4">

                <div class="flex-1">
                    <h2 class="text-xl font-bold"><%= item.product.title %></h2>
                    <p class="text-purple-600 font-bold">
                        <% if (item.product.salePrice) { %>
                            <span class="line-through text-gray-400">$<%= item.product.price.toFixed(2) %></span>
                            $<%= item.product.salePrice.toFixed(2) %>
                        <% } else { %>
                            $<%= item.product.price.toFixed(2) %>
                        <% } %>
                    </p>
                    <p class="text-gray-600">Quantity: <%= item.quantity %></p>
                    <p class="text-green-600 font-bold">Total: $<%= (item.product.salePrice ? item.product.salePrice : item.product.price) * item.quantity %></p>
                </div>

                <div class="flex items-center">
                    <form action="/cart/update/<%= item.product._id %>" method="POST" class="mr-2">
                        <input type="number" name="quantity" value="<%= item.quantity %>" min="1" class="w-20 px-2 py-1 border rounded text-center">
                        <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-3 rounded ml-2">Update</button>
                    </form>
                    <form action="/cart/remove/<%= item.product._id %>" method="POST">
                        <button type="submit" class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-3 rounded">Remove</button>
                    </form>
                </div>
            </div>
        <% }); %>
    </div>

    <div class="mt-8 p-6 bg-gray-100 rounded-lg">
        <h2 class="text-2xl font-semibold mb-4">Cart Summary</h2>
        <p class="text-gray-700">Subtotal: $<%= cart.subtotal.toFixed(2) %></p>
        <p class="text-gray-700">Tax (10%): $<%= cart.tax.toFixed(2) %></p>
        <p class="text-2xl font-bold">Total: $<%= cart.total.toFixed(2) %></p>

        <form action="/cart/place-order" method="POST" class="mt-6">
            <button type="submit" class="bg-purple-500 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-full">Place Order</button>
        </form>
    </div>
    <% } else { %>
        <p class="text-center text-red-500 font-bold text-lg">Your cart is empty.</p>
    <% } %>
</section>

<% if (recommendations && recommendations.length > 0) { %>
<section class="container mx-auto px-4 py-10">
    <h2 class="text-2xl font-bold text-center text-purple-800 mb-6">You Might Also Like</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% recommendations.forEach(product => { %>
            <%- include('partials/product', { product }) %>
        <% }) %>
    </div>
</section>
<% } %>