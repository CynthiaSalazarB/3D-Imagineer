<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@700;800&amp;family=Public+Sans:wght@400;600;700&amp;display=swap">
    <link rel="stylesheet" href="/css/storefront.css">
    <style>
        /* Sticky footer: on pages shorter than the viewport, push the footer to the
           bottom instead of letting it float up under the content. Plain CSS rather
           than utility classes so the layout does not depend on the Tailwind build. */
        body { display: flex; flex-direction: column; min-height: 100vh; }
        main { flex: 1 0 auto; }
    </style>
</head>
<body>

    <%- include('../partials/navbar') %>

    <main>

        <%- body %>
    </main>

    <%- include('../partials/footer') %>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
</body>
</html>
