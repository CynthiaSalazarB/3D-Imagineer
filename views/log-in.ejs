

<section class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-center text-purple-800 mb-8">Welcome Back</h1>

    <% if (typeof message !== "undefined") { %>
        <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
            <h2 class="font-bold">Error</h2>
            <p><%= message %></p>
            <a href="/log-in" class="text-purple-800">Go to Log In</a>
        </div>
    <% } %>
    
    <form class="max-w-md mx-auto" action="/log-in" method="POST">
        <div class="mb-4">
            <input type="text" id="email" name="email" value="<%=values.email%>" class="w-full px-3 py-2 border rounded" placeholder="Email"><br>
            <%if (errorMessage.email){%>
                <span style="color:red;"><%=errorMessage.email%></span><br>
            <%}%>
        </div>
        <div class="mb-4">
            <input type="password" id="password" name="password" value="<%=values.password%>" class="w-full px-3 py-2 border rounded" placeholder="Password"><br>
            <%if (errorMessage.password){%>
                <span style="color:red;"><%=errorMessage.password%></span><br>
            <%}%>
        </div>
        <div>
            <% if (typeof errors !== "undefined" && errors.length > 0) { %>
                <% errors.forEach(err => { %>
                    <span style="color:red;"><%=err%></span><br><br>
                <% }) %>
            <% } %>

        </div>
        <button type="submit" class="w-full bg-purple-600 text-white py-2 rounded hover:bg-purple-700">Continue</button>

    </form>

    <div class="max-w-md mx-auto mt-8 p-4 bg-purple-50 border border-purple-200 rounded text-sm text-gray-700">
        <p class="font-bold text-purple-800 mb-2">Demo accounts</p>
        <p class="mb-1">Try both sides of the store without signing up. Click to fill in.</p>
        <ul class="mt-3 space-y-2">
            <li>
                <button type="button" class="text-left w-full hover:text-purple-800 transition"
                        data-demo-email="clerk@demo.3dimagineer.app"
                        data-demo-password="DemoClerk2026">
                    <span class="font-bold">Clerk</span> manages inventory<br>
                    <span class="text-gray-500">clerk@demo.3dimagineer.app / DemoClerk2026</span>
                </button>
            </li>
            <li>
                <button type="button" class="text-left w-full hover:text-purple-800 transition"
                        data-demo-email="customer@demo.3dimagineer.app"
                        data-demo-password="DemoCustomer2026">
                    <span class="font-bold">Customer</span> browses and buys<br>
                    <span class="text-gray-500">customer@demo.3dimagineer.app / DemoCustomer2026</span>
                </button>
            </li>
        </ul>
    </div>

    <script>
        document.querySelectorAll("[data-demo-email]").forEach(button => {
            button.addEventListener("click", () => {
                document.getElementById("email").value = button.dataset.demoEmail;
                document.getElementById("password").value = button.dataset.demoPassword;
            });
        });
    </script>

</section>
