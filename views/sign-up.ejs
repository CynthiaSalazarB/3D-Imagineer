<section class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-center text-purple-800 mb-8">Sign Up</h1>
    <form class="max-w-md mx-auto" action="/sign-up" method="POST">
        <div class="mb-4">
            <input type="text" id="firstName" name="firstName" value="<%=values.firstName%>" class="w-full px-3 py-2 border rounded" placeholder="First Name"><br>
            <%if (errorMessage.firstName){%>
                <span style="color:red;"><%=errorMessage.firstName%></span><br>
            <%}%>
        </div>
        <div class="mb-4">
            <input type="text" id="lastName" name="lastName" value="<%=values.lastName%>" class="w-full px-3 py-2 border rounded" placeholder="Last Name"><br>
            <%if (errorMessage.lastName){%>
                <span style="color:red;"><%=errorMessage.lastName%></span><br>
            <%}%>
        </div>
        <div class="mb-4">
            <input type="text" id="email" name="email" value="<%=values.email%>" class="w-full px-3 py-2 border rounded" placeholder="Email"><br>
            <%if (errorMessage.email){%>
                <span style="color:red;"><%=errorMessage.email%></span><br>
            <%}%>
        </div>
        <div class="mb-4">
            <input type="password" id="password" name="password" value="<%=values.password%>" class="w-full px-3 py-2 border rounded" placeholder="Password"><br>
            <%if (errorMessage.password){%>
                <span style="color:red;"><%=errorMessage.password%></span><br>
            <%}%>
        </div>
        <button type="submit" class="w-full bg-purple-600 text-white py-2 rounded hover:bg-purple-700">Continue</button>
    </form>
</section>
