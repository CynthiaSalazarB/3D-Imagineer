# Copy this file to config/.env and fill it in. config/.env is gitignored.

# Required. The server does not start until this connects.
MONGODB_CONNECTION_STRING=

# Required. Any random string, this signs the session cookie so a client cannot
# forge one. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Without it the recommendation engine falls back to category matching
# rather than failing. Get one from Google AI Studio.
GEMINI_API_KEY=

# Only needed for sign-up and order confirmation emails. Mailgun.
# A sandbox domain only delivers to recipients authorized in the Mailgun
# dashboard. Sending to arbitrary addresses requires a verified domain.
API_KEY=
MAILGUN_DOMAIN=

PORT=8080
